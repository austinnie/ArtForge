{
  "title": "东方艺术 yokai之歌",
  "emotion": "mysterious",
  "language": "zh",
  "structure": {
    "verse": [
      "在神秘的光辉中，",
      "我听见东方艺术 yokai的呼唤",
      "微风轻拂过心间，",
      "带来永恒的旋律"
    ],
    "chorus": [
      "东方艺术 yokai，如此神秘，",
      "照亮我前行的路",
      "在这无尽的时空里，",
      "与你共舞"
    ],
    "bridge": [
      "当星光洒落，",
      "当万物沉寂",
      "我依然能听见",
      "那来自远方的歌"
    ]
  },
  "vocal_style": "力量激昂"
}